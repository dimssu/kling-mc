{
  "name": "kling-mc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS=--max-old-space-size=4096 next dev",
    "dev:worker": "NODE_OPTIONS=--max-old-space-size=2048 dotenv -e .env.local -- tsx watch src/worker/index.ts",
    "build": "next build",
    "start": "NODE_OPTIONS=--max-old-space-size=4096 next start",
    "start:worker": "NODE_OPTIONS=--max-old-space-size=2048 dotenv -e .env.local -- tsx src/worker/index.ts",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "infra:up": "docker compose -f docker-compose.dev.yml up -d",
    "infra:down": "docker compose -f docker-compose.dev.yml down",
    "infra:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "app:start": "bash scripts/start.sh",
    "app:stop": "bash scripts/stop.sh",
    "app:status": "bash scripts/status.sh",
    "app:restart": "bash scripts/stop.sh && bash scripts/start.sh",
    "app:logs": "tail -f .run/logs/*.log",
    "migrate:legacy": "dotenv -e .env.local -- tsx scripts/migrate-pg-minio-to-mongo-s3.ts",
    "sync:gallery": "dotenv -e .env.local -- tsx scripts/sync-to-gallery.ts",
    "backfill:hashes": "dotenv -e .env.local -- tsx scripts/backfill-content-hashes.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1042.0",
    "@aws-sdk/lib-storage": "^3.1042.0",
    "@aws-sdk/s3-request-presigner": "^3.1042.0",
    "@google/genai": "^1.52.0",
    "@hookform/resolvers": "^5.2.2",
    "@next/env": "^16.2.4",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.100.9",
    "bullmq": "^5.76.5",
    "busboy": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.14.0",
    "mongoose": "^8.10.0",
    "next": "16.2.4",
    "pg": "^8.13.0",
    "pino": "^10.3.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.75.0",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/busboy": "^1.5.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/pg": "^8.11.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msgpackr-extract"
    ]
  }
}
