generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MediaAsset {
  id           String   @id @default(cuid())
  ownerId      String
  kind         String
  filename     String
  mimeType     String
  sizeBytes    Int
  durationSec  Float?
  width        Int?
  height       Int?
  storageKey   String
  thumbnailKey String?
  isFavorite   Boolean  @default(false)
  createdAt    DateTime @default(now())

  sourceForGenerations         Generation[]      @relation("SourceVideo")
  referenceForGenerations      Generation[]      @relation("ReferenceImage")
  outputForGeneration          Generation?       @relation("Output")
  // Image-gen relations: a MediaAsset can be a scene/style for image-gens.
  // Subject images are tracked as a Postgres String[] on ImageGeneration
  // (no FK), since Prisma doesn't model FK on array columns.
  sceneForImageGenerations     ImageGeneration[] @relation("ImageGenScene")
  styleForImageGenerations     ImageGeneration[] @relation("ImageGenStyle")
  outputForImageGeneration     ImageGeneration?  @relation("ImageGenOutput")

  @@index([ownerId, kind, createdAt])
  @@index([ownerId, isFavorite])
}

model Generation {
  id                   String    @id @default(cuid())
  ownerId              String
  status               String
  provider             String    @default("kling_official")
  providerTaskId       String?   @unique
  externalTaskId       String    @unique
  sourceVideoId        String
  referenceImageId     String
  outputAssetId        String?   @unique
  prompt               String?
  modelName            String
  mode                 String
  characterOrientation String
  keepOriginalSound    Boolean   @default(true)
  watermarkEnabled     Boolean   @default(false)
  estimatedCostUsd     Decimal   @db.Decimal(10, 4)
  actualCostUsd        Decimal?  @db.Decimal(10, 4)
  finalUnitDeduction   String?
  errorCode            Int?
  errorMessage         String?
  rawProviderPayload   Json?
  isFavorite           Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  submittedAt          DateTime?
  completedAt          DateTime?

  // Caption pack — populated by the LLM after the media is ready, only when
  // captionPackEnabled was set on the request. Stored alongside the row so
  // we don't re-call the LLM on every page view.
  captionPackEnabled     Boolean   @default(false)
  caption                String?
  captionTags            String[]
  captionLocation        String?
  captionAccessibility   String?
  captionPackGeneratedAt DateTime?

  sourceVideo    MediaAsset  @relation("SourceVideo", fields: [sourceVideoId], references: [id])
  referenceImage MediaAsset  @relation("ReferenceImage", fields: [referenceImageId], references: [id])
  outputAsset    MediaAsset? @relation("Output", fields: [outputAssetId], references: [id])

  @@index([ownerId, status, createdAt])
  @@index([ownerId, isFavorite])
  @@index([status, submittedAt])
}

model ImageGeneration {
  id                 String    @id @default(cuid())
  ownerId            String
  status             String
  provider           String    @default("kling_official")
  providerTaskId     String?   @unique
  externalTaskId     String    @unique
  // Which Kling image endpoint to call. Drives request body shape + pricing.
  // "multi-image2image" → /v1/images/multi-image2image (kling-v2/v2-1, ≥2 refs)
  // "image2image"       → /v1/images/generations with image= (kling-v1/v1-5/v2/v2-new/v2-1)
  endpoint           String    @default("multi-image2image")
  // Subjects: 1..4 MediaAsset IDs (Postgres native String[]). No FK because
  // Prisma can't model FK on array columns; orphans are fine for single-user.
  subjectImageIds    String[]
  sceneImageId       String?
  styleImageId       String?
  outputAssetId      String?   @unique
  prompt             String?
  negativePrompt     String?
  modelName          String
  aspectRatio        String?
  n                  Int       @default(1)
  // image_reference for /v1/images/generations on kling-v1-5 / kling-v2-1.
  // "subject" focuses on identity; "face" prioritises facial likeness.
  imageReference     String?
  estimatedCostUsd   Decimal   @db.Decimal(10, 4)
  actualCostUsd      Decimal?  @db.Decimal(10, 4)
  finalUnitDeduction String?
  errorCode          Int?
  errorMessage       String?
  rawProviderPayload Json?
  isFavorite         Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  submittedAt        DateTime?
  completedAt        DateTime?

  captionPackEnabled     Boolean   @default(false)
  caption                String?
  captionTags            String[]
  captionLocation        String?
  captionAccessibility   String?
  captionPackGeneratedAt DateTime?

  // Carousel membership: when set, this row is one slide of an ImageCarousel.
  // The parent owns the unified caption pack (per-slide captioning is skipped).
  carouselId String?
  slotIndex  Int?
  poseLabel  String?

  sceneImage  MediaAsset?    @relation("ImageGenScene", fields: [sceneImageId], references: [id])
  styleImage  MediaAsset?    @relation("ImageGenStyle", fields: [styleImageId], references: [id])
  outputAsset MediaAsset?    @relation("ImageGenOutput", fields: [outputAssetId], references: [id])
  carousel    ImageCarousel? @relation("CarouselSlides", fields: [carouselId], references: [id], onDelete: Cascade)

  @@index([ownerId, status, createdAt])
  @@index([ownerId, isFavorite])
  @@index([status, submittedAt])
  @@index([carouselId, slotIndex])
}

model ImageCarousel {
  id                 String   @id @default(cuid())
  ownerId            String
  status             String   // queued | processing | partial | completed | failed
  n                  Int
  themePrompt        String?
  vibeLabel          String?
  // Single subject MediaAsset id. Same convention as ImageGeneration's
  // subjectImageIds: stored as a string with no FK so cleanup is decoupled.
  subjectImageId     String
  modelName          String
  // Endpoint used for every child slide. Defaults to image2image (single
  // subject) since that's the natural fit for a carousel — a stylised pose
  // pack from one source photo.
  endpoint           String   @default("image2image")
  imageReference     String?
  aspectRatio        String?
  estimatedCostUsd   Decimal  @db.Decimal(10, 4)

  // Unified caption pack for the carousel as a whole; populated by the
  // carousel-finalize worker after all slides reach a terminal state.
  caption                String?
  captionTags            String[]  @default([])
  captionLocation        String?
  captionAccessibility   String?
  captionGeneratedAt     DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  slides ImageGeneration[] @relation("CarouselSlides")

  @@index([ownerId, createdAt])
  @@index([status])
}
