# Kling official API (REQUIRED)
# Obtain from https://app.klingai.com/global/dev — create API key, save Access + Secret
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_BASE_URL=https://api-singapore.klingai.com
KLING_TOKEN_TTL_SECONDS=1800
KLING_DEFAULT_MODEL=kling-v2-6
KLING_DEFAULT_MODE=std

# MongoDB (Atlas or self-hosted). Same cluster as kling-gallery, different DB.
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=kling_mc

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# AWS S3 (shared bucket with kling-gallery; this app writes under `mc/` prefix).
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public URL base — direct S3 (https://my-bucket.s3.us-east-1.amazonaws.com)
# or a CloudFront distribution. No trailing slash.
S3_PUBLIC_URL_BASE=
# Same value as S3_PUBLIC_URL_BASE, but baked into the client bundle so the
# browser can render thumbnails directly from S3. Must be set at build time.
NEXT_PUBLIC_S3_PUBLIC_URL_BASE=

# App
APP_BASE_URL=http://localhost:3000
DEFAULT_USER_ID=local
ENABLE_KLING_WEBHOOKS=false
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=

# Concurrency
MAX_CONCURRENT_GENERATIONS=2

# Logging
LOG_LEVEL=info
NODE_ENV=development

# Google Gemini — used for the optional "caption pack" (caption + tags +
# location + alt text) and the "Suggest prompt" button on image creation.
# Get a key at https://aistudio.google.com/app/apikey. Free tier is fine.
# Leave blank to disable both LLM features.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: kling-gallery sync (scripts/sync-to-gallery.ts)
GALLERY_INGEST_URL=
GALLERY_INGEST_TOKEN=

# Legacy Postgres + MinIO config — only needed when running the one-shot
# scripts/migrate-pg-minio-to-mongo-s3.ts. Delete after migration.
LEGACY_DATABASE_URL=
LEGACY_S3_ENDPOINT=
LEGACY_S3_BUCKET=
LEGACY_S3_ACCESS_KEY=
LEGACY_S3_SECRET_KEY=
